---
/**
 * Encabezado de sección. Existe para que las seis secciones de la ficha abran
 * exactamente igual: mismo antetítulo con filete, mismo salto al título, misma
 * medida de línea en el texto de entrada.
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** `dark` invierte los colores para secciones sobre verde o negro. */
  tone?: "light" | "dark";
  align?: "start" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  tone = "light",
  align = "start",
  class: className = "",
} = Astro.props;

const isDark = tone === "dark";
---

<header
  class:list={[
    "reveal max-w-3xl",
    align === "center" && "mx-auto text-center",
    className,
  ]}
>
  {
    eyebrow && (
      <p
        class:list={[
          "type-eyebrow flex items-center gap-3",
          align === "center" && "justify-center",
          isDark ? "text-accent-light" : "text-accent-deep",
        ]}
      >
        <span
          class:list={[
            "h-px w-8",
            isDark ? "bg-accent-light/50" : "bg-accent/45",
          ]}
          aria-hidden="true"
        />
        {eyebrow}
      </p>
    )
  }

  <h2
    class:list={["type-title mt-5", isDark ? "text-on-primary" : "text-ink"]}
  >
    {title}
  </h2>

  {
    description && (
      <p
        class:list={[
          "type-body mt-5 max-w-2xl",
          align === "center" && "mx-auto",
          isDark ? "text-on-primary/70" : "text-muted",
        ]}
      >
        {description}
      </p>
    )
  }

  <slot />
</header>
