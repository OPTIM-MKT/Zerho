---
import Icon from "@/components/ui/Icon.astro";

/**
 * Vuelta al inicio. Sólo en escritorio: en móvil, la barra de secciones ya
 * ocupa esa esquina y lleva a cualquier parte de la ficha, incluida la primera.
 */
---

<button
  type="button"
  data-scroll-top
  aria-label="Volver al inicio de la ficha"
  class="material-chrome fixed bottom-8 right-8 z-40 hidden h-12 w-12 translate-y-4 scale-90 cursor-pointer place-items-center rounded-full border border-line text-ink opacity-0 shadow-e2 transition-[opacity,transform] duration-400 ease-[var(--ease-out-expo)] active:scale-90 lg:grid"
>
  <Icon name="arrow-up" class="h-5 w-5" strokeWidth={1.8} />
</button>

<script>
  const THRESHOLD = 480;

  let cleanup: (() => void) | null = null;

  function initScrollTop() {
    cleanup?.();

    const button = document.querySelector<HTMLElement>("[data-scroll-top]");
    if (!button) return;

    let frame = 0;

    const render = () => {
      const visible = window.scrollY > THRESHOLD;
      button.classList.toggle("opacity-0", !visible);
      button.classList.toggle("translate-y-4", !visible);
      button.classList.toggle("scale-90", !visible);
      button.classList.toggle("pointer-events-none", !visible);
      frame = 0;
    };

    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(render);
    };

    const onClick = () => {
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    button.addEventListener("click", onClick);
    render();

    cleanup = () => {
      window.removeEventListener("scroll", onScroll);
      button.removeEventListener("click", onClick);
      cancelAnimationFrame(frame);
      cleanup = null;
    };
  }

  document.addEventListener("astro:page-load", initScrollTop);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
