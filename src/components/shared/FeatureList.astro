---
import Icon from "@/components/ui/Icon.astro";

/**
 * Lista de características en prosa corta.
 *  · `stack`   — una columna, se lee como pliego de condiciones
 *  · `columns` — dos columnas en pantallas anchas
 *  · `pills`   — resumen rápido, sin jerarquía interna
 */
interface Props {
  items: readonly string[];
  variant?: "stack" | "columns" | "pills";
  tone?: "light" | "dark";
  class?: string;
}

const {
  items,
  variant = "stack",
  tone = "light",
  class: className = "",
} = Astro.props;

const isDark = tone === "dark";
---

{
  variant === "pills" ? (
    <ul class:list={["flex flex-wrap gap-2", className]}>
      {items.map((item) => (
        <li
          class:list={[
            "rounded-full px-3.5 py-1.5 text-xs font-medium",
            isDark
              ? "border border-white/15 bg-white/5 text-on-primary/80"
              : "border border-line bg-panel text-muted",
          ]}
        >
          {item}
        </li>
      ))}
    </ul>
  ) : (
    <ul
      class:list={[
        "grid gap-x-10 gap-y-4",
        variant === "columns" && "sm:grid-cols-2",
        className,
      ]}
    >
      {items.map((item, i) => (
        <li
          class:list={[
            "reveal flex items-start gap-3.5 text-[0.95rem] leading-relaxed",
            isDark ? "text-on-primary/75" : "text-muted",
          ]}
          style={`transition-delay:${Math.min(i * 45, 320)}ms`}
        >
          <span
            class:list={[
              "mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full",
              isDark
                ? "bg-accent-light/15 text-accent-light"
                : "bg-accent/12 text-accent-deep",
            ]}
            aria-hidden="true"
          >
            <Icon name="check" class="h-3 w-3" strokeWidth={2.8} />
          </span>
          {item}
        </li>
      ))}
    </ul>
  )
}
