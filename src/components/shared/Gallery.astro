---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import { galleryId, getGalleryImages } from "@/lib/gallery";

/**
 * Galería en mosaico con visor a pantalla completa.
 *
 * Las imágenes se descubren en build desde `src/assets/<dir>/`: añadir una foto
 * a la carpeta la publica, sin tocar el .md ni este componente.
 */
interface Props {
  /** Ruta bajo `src/assets/`, p. ej. `images/gal/prueba`. */
  dir: string;
  /** Nombre legible de la residencia; alimenta los textos alternativos. */
  subject?: string;
  layout?: "mosaic" | "grid";
  /** Corta el mosaico en las primeras N imágenes. */
  limit?: number;
  class?: string;
}

const {
  dir,
  subject = "",
  layout = "mosaic",
  limit,
  class: className = "",
} = Astro.props;

const all = getGalleryImages(dir);
const images = typeof limit === "number" ? all.slice(0, limit) : all;
const id = galleryId(dir);

/**
 * Ritmo del mosaico: la primera toma manda, y a partir de ahí ninguna fila
 * repite la forma de la anterior. Cuando se acaba el patrón, se repite.
 */
const MOSAIC_SPANS = [
  "sm:col-span-4 sm:row-span-2",
  "sm:col-span-2",
  "sm:col-span-2",
  "sm:col-span-3",
  "sm:col-span-3",
  "sm:col-span-2",
  "sm:col-span-4",
  "sm:col-span-2",
];
---

{
  images.length > 0 && (
    <div
      id={id}
      data-pswp-gallery
      class:list={[
        "not-prose grid auto-rows-[12rem] grid-cols-2 gap-3 sm:auto-rows-[10.5rem] sm:gap-4 lg:auto-rows-[12.5rem]",
        layout === "mosaic" ? "sm:grid-cols-6" : "sm:grid-cols-3",
        className,
      ]}
    >
      {images.map((src, i) => {
        const caption = subject
          ? `${subject} — imagen ${i + 1} de ${images.length}`
          : `Imagen ${i + 1} de ${images.length}`;

        return (
          <a
            href={src.src}
            data-pswp-width={src.width}
            data-pswp-height={src.height}
            data-pswp-caption={caption}
            target="_blank"
            rel="noreferrer"
            aria-label={`Ampliar: ${caption}`}
            class:list={[
              "press-soft group relative block overflow-hidden rounded-panel bg-panel-alt shadow-e1 focus-visible:outline-offset-4",
              layout === "mosaic"
                ? MOSAIC_SPANS[i % MOSAIC_SPANS.length]
                : "sm:col-span-1",
              layout === "mosaic" && i === 0 && "col-span-2 row-span-2",
            ]}
          >
            <Image
              src={src}
              alt={caption}
              widths={[400, 800, 1400]}
              sizes="(min-width: 1024px) 45vw, (min-width: 640px) 50vw, 92vw"
              loading={i < 2 ? "eager" : "lazy"}
              class="h-full w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
            />

            {/* El velo y el icono sólo aparecen con la intención: en reposo
                manda la fotografía, no la interfaz. */}
            <span
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-base-black/55 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute bottom-3.5 right-3.5 grid h-9 w-9 translate-y-2 place-items-center rounded-full border border-white/25 bg-white/15 text-white opacity-0 backdrop-blur-md transition-[opacity,transform] duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
              aria-hidden="true"
            >
              <Icon name="maximize" class="h-4 w-4" strokeWidth={1.9} />
            </span>
          </a>
        );
      })}
    </div>
  )
}

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  let lightboxes: PhotoSwipeLightbox[] = [];

  function destroyGalleries() {
    lightboxes.forEach((lb) => lb.destroy());
    lightboxes = [];
  }

  function initGalleries() {
    destroyGalleries();

    document
      .querySelectorAll<HTMLElement>("[data-pswp-gallery]")
      .forEach((el) => {
        const lb = new PhotoSwipeLightbox({
          gallery: `#${el.id}`,
          children: "a",
          bgOpacity: 0.94,
          // Zoom desde la miniatura: la foto crece desde donde estaba, no
          // aparece de la nada en el centro de la pantalla.
          showHideAnimationType: "zoom",
          pswpModule: () => import("photoswipe"),
        });

        lb.on("uiRegister", () => {
          lb.pswp?.ui?.registerElement({
            name: "caption",
            order: 9,
            isButton: false,
            appendTo: "root",
            html: "",
            onInit: (element, pswp) => {
              element.classList.add("pswp-caption");
              pswp.on("change", () => {
                element.textContent =
                  pswp.currSlide?.data.element?.dataset.pswpCaption ?? "";
              });
            },
          });
        });

        lb.init();
        lightboxes.push(lb);
      });
  }

  document.addEventListener("astro:page-load", initGalleries);
  document.addEventListener("astro:before-swap", destroyGalleries);
</script>
