---
/**
 * Declaración destacada con cifra: la garantía de diez años y poco más.
 * Es deliberadamente escaso — si se usa en cada sección, deja de destacar.
 */
interface Props {
  figure: string;
  figureUnit?: string;
  title: string;
  body: string;
  class?: string;
}

const {
  figure,
  figureUnit,
  title,
  body,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "reveal card-on-primary flex flex-col gap-8 p-8 sm:flex-row sm:items-center sm:gap-12 lg:p-12",
    className,
  ]}
>
  <p class="flex shrink-0 items-baseline gap-2">
    <span
      class="font-[family-name:var(--font-display)] text-[clamp(3.5rem,9vw,6rem)] leading-[0.85] tracking-[-0.04em] text-accent-light tabular-nums"
    >
      {figure}
    </span>
    {
      figureUnit && (
        <span class="type-label text-on-primary-muted">{figureUnit}</span>
      )
    }
  </p>

  <div class="sm:border-l sm:border-white/12 sm:pl-12">
    <h3 class="type-heading text-on-primary">{title}</h3>
    <p class="mt-3.5 max-w-xl text-[0.95rem] leading-relaxed text-on-primary/65">
      {body}
    </p>
  </div>
</div>
